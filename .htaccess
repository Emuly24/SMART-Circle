# Force HTTPS (keep this - it's fine)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Prevent directory listing
Options -Indexes

# Block sensitive files (Apache 2.4+ syntax)
<FilesMatch "^(config\.php|update_config\.php)$">
    Require all denied
</FilesMatch>

# Block all hidden files (.htaccess, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Explicitly block .htaccess itself
<Files ".htaccess">
    Require all denied
</Files>

# Never serve docs, SQL dumps or text exports (robots.txt stays public).
# database_schema_export.txt may still exist on the server from the old export_schema.php.
<FilesMatch "\.(md|sql|log)$|^database_schema_export\.txt$">
    Require all denied
</FilesMatch>
