# SMART Circle — root rules (the repository root is the InfinityFree htdocs folder).
# Only public/ is reachable from the web. Code (src/), settings (config/, secrets.php),
# migrations (database/) and uploads (storage/) can never be requested directly.
Options -Indexes
RewriteEngine On

# Send every request into public/ (unless it already points there).
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

# Belt and braces: never serve dotfiles or PHP/SQL files outside public/.
<FilesMatch "^\.|\.(sql|md|lock|dist|sh|py|log)$">
    Require all denied
</FilesMatch>
