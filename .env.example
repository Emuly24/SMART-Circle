# Copy this file to .env and fill in your values.
# .env is gitignored and never deployed via FTP.

APP_DEBUG=false

DB_HOST=your-database-host.example.com
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

ADMIN_EMAIL=admin@example.com
# Admin password as a HASH, never plain text. Generate with:
#   php -r "echo password_hash('your-admin-password', PASSWORD_DEFAULT), PHP_EOL;"
# Used only until an admin hash is saved in the admin_settings table.
ADMIN_PASSWORD_HASH=
CSRF_SECRET=replace-with-a-long-random-hex-string
SESSION_SECRET=replace-with-another-long-random-hex-string
