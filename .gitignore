# Secrets: real values live only on the server (copy secrets.example.php)
/secrets.php
.env

# Runtime data (created on the server)
/storage/logs/*
/storage/uploads/*
/storage/cache/*
!/storage/**/.gitkeep

# Dev tooling
/vendor/
/node_modules/
/.phpunit.cache/
/tests/_output/

# Backups and dumps (the schema lives in database/migrations)
*.sql
!/database/migrations/*.sql
!/database/schema.sql
!/database/drop-old-site-tables.sql
backup_*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
