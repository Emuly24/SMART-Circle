<?php

require_once __DIR__ . '/config/bootstrap.php';

use SmartCircle\Data\Database;
use SmartCircle\Support\Env;

// ===== ERROR REPORTING =====
$debug = Env::bool('APP_DEBUG', false);
error_reporting(E_ALL);
ini_set('display_errors', $debug ? '1' : '0');

// ===== CONSTANTS (backward compatibility for legacy scripts) =====
if (!defined('DB_HOST')) {
    define('DB_HOST', Env::require('DB_HOST'));
}
if (!defined('DB_NAME')) {
    define('DB_NAME', Env::require('DB_NAME'));
}
if (!defined('DB_USER')) {
    define('DB_USER', Env::require('DB_USER'));
}
if (!defined('DB_PASS')) {
    define('DB_PASS', Env::get('DB_PASS', '') ?? '');
}
if (!defined('ADMIN_EMAIL')) {
    define('ADMIN_EMAIL', Env::require('ADMIN_EMAIL'));
}
if (!defined('CSRF_SECRET')) {
    define('CSRF_SECRET', Env::require('CSRF_SECRET'));
}
if (!defined('SESSION_SECRET')) {
    define('SESSION_SECRET', Env::require('SESSION_SECRET'));
}

// ===== DATA ACCESS LAYER =====

/** Primary database connection — use this in all new code. */
function getPDO(): PDO
{
    return Database::getInstance()->getConnection();
}

/**
 * Legacy mysqli connection for scripts not yet migrated to PDO.
 *
 * @deprecated Migrate callers to getPDO() with prepared statements.
 */
function getDB(): mysqli
{
    static $conn = null;

    if ($conn !== null && !@$conn->ping()) {
        $conn = null;
    }

    if ($conn === null) {
        $conn = new mysqli(DB_HOST, DB_USER, DB_PASS, DB_NAME);

        if ($conn->connect_error) {
            error_log('Database connection failed: ' . $conn->connect_error);
            die('Database connection failed. Please try again later.');
        }

        $conn->set_charset('utf8mb4');
    }

    return $conn;
}

// ===== DATABASE SESSION HANDLER (PDO) =====

function sess_open($savePath, $sessionName): bool
{
    return true;
}

function sess_close(): bool
{
    return true;
}

function sess_read(string $id): string
{
    $stmt = getPDO()->prepare('SELECT data FROM sessions WHERE id = ?');
    $stmt->execute([$id]);
    $row = $stmt->fetch();

    return $row ? (string) $row['data'] : '';
}

function sess_write(string $id, string $data): bool
{
    $stmt = getPDO()->prepare(
        'REPLACE INTO sessions (id, data, last_accessed) VALUES (?, ?, NOW())'
    );

    return $stmt->execute([$id, $data]);
}

function sess_destroy(string $id): bool
{
    $stmt = getPDO()->prepare('DELETE FROM sessions WHERE id = ?');

    return $stmt->execute([$id]);
}

function sess_gc(int $maxlifetime): int|false
{
    $stmt = getPDO()->prepare(
        'DELETE FROM sessions WHERE last_accessed < NOW() - INTERVAL ? SECOND'
    );
    $stmt->execute([$maxlifetime]);

    return $stmt->rowCount();
}

// Fail fast if the database is unreachable before registering the session handler.
try {
    Database::getInstance();
} catch (RuntimeException $e) {
    http_response_code(503);
    die($e->getMessage());
}

session_set_save_handler(
    'sess_open',
    'sess_close',
    'sess_read',
    'sess_write',
    'sess_destroy',
    'sess_gc'
);

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

// ===== SHARED HELPERS =====

function log_activity(int $user_id, string $action, ?string $details = null): void
{
    $ip = $_SERVER['REMOTE_ADDR'] ?? '';
    $details = $details ?? '';

    $stmt = getPDO()->prepare(
        'INSERT INTO activity_log (user_id, action, details, ip_address) VALUES (?, ?, ?, ?)'
    );
    $stmt->execute([$user_id, $action, $details, $ip]);
}

function getAdminHash(): string
{
    static $hash = null;

    if ($hash !== null) {
        return $hash;
    }

    $pdo = getPDO();
    $stmt = $pdo->prepare("SELECT setting_value FROM admin_settings WHERE setting_key = 'admin_hash'");
    $stmt->execute();
    $row = $stmt->fetch();

    if ($row) {
        $hash = (string) $row['setting_value'];
        return $hash;
    }

    $hash = password_hash('smarttutor@2026', PASSWORD_DEFAULT);
    $stmt = $pdo->prepare(
        "INSERT INTO admin_settings (setting_key, setting_value) VALUES ('admin_hash', ?)
         ON DUPLICATE KEY UPDATE setting_value = ?"
    );
    $stmt->execute([$hash, $hash]);

    return $hash;
}

function is_content_unlocked(string $content_type, int $content_id, ?int $user_id = null): bool
{
    if ($user_id === null) {
        $user_id = (int) ($_SESSION['user_id'] ?? 0);
    }

    if (!$user_id) {
        return false;
    }

    $pdo = getPDO();

    $stmt = $pdo->prepare('SELECT group_id FROM group_members WHERE user_id = ?');
    $stmt->execute([$user_id]);
    $group = $stmt->fetch();

    if (!$group) {
        return false;
    }

    $group_id = (int) $group['group_id'];

    $stmt = $pdo->prepare(
        'SELECT is_locked FROM group_content_locks
         WHERE group_id = ? AND content_type = ? AND content_id = ?'
    );
    $stmt->execute([$group_id, $content_type, $content_id]);
    $lock = $stmt->fetch();

    if (!$lock) {
        $stmt = $pdo->prepare(
            'INSERT INTO group_content_locks (group_id, content_type, content_id, is_locked)
             VALUES (?, ?, ?, 1)'
        );
        $stmt->execute([$group_id, $content_type, $content_id]);
        return false;
    }

    return (int) $lock['is_locked'] === 0;
}
